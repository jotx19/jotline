{
  "name": "jotline-tui",
  "version": "2.0.0",
  "description": "Interactive terminal UI for jotline: live tool calls, diffs you can expand, inline approvals",
  "license": "MIT",
  "author": "jotx19",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jotx19/jotline.git",
    "directory": "packages/tui"
  },
  "type": "module",
  "bin": {
    "jotline-tui": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && node dist/src/cli.js"
  },
  "dependencies": {
    "diff": "9.0.0",
    "ink": "5.0.1",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/diff": "5.2.1",
    "@types/node": "20.14.2",
    "@types/react": "18.3.3",
    "typescript": "5.4.5"
  }
}
